# Secure uploads: allow images, block executable scripts

# Allow common image types (profile pictures, thumbnails)
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    Order allow,deny
    Allow from all
</FilesMatch>

# Allow PDFs if needed (e.g., documents), comment out to block
# <FilesMatch "\.(pdf)$">
#     Order allow,deny
#     Allow from all
# </FilesMatch>

# Block PHP and other executable scripts
<FilesMatch "\.(php|phtml|php3|php4|php5|phps|pl|py|cgi)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Prevent directory listing
Options -Indexes
